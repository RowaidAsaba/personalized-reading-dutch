# Copy this file to .env for local running. Keep .env private and never commit real keys.

# Database. Local: SQLite file. Production (Neon): postgresql+psycopg://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=sqlite:///./dev.db

# Frontend origins allowed to call the API (comma separated).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Gemini: text generation, word recommendations and dictionary look-ups.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Authentication. Generate a long random secret, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=
# How long a login stays valid (default 14 days).
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# "Continue with Google": the OAuth 2.0 Web client ID from Google Cloud Console.
# Leave empty to hide the Google button. Must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=
